<Window x:Class="CybersecurityChatbot.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CybersecurityChatbot.Converters"
        Title="Cybersecurity Assistant – Welcome"
        Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <TextBlock Text="🔐 Cybersecurity Assistant" FontSize="24" FontWeight="Bold" Foreground="#4C9AFF" TextAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Please enter your name to begin" Foreground="White" Margin="0,0,0,10" TextAlignment="Center"/>
            <TextBox x:Name="NameTextBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" 
                     Width="250" Height="35" Margin="0,0,0,20"
                     Background="#3D3D4D" Foreground="White" BorderBrush="#888"/>
            <Button Content="Let's go" Command="{Binding LetGoCommand}" Width="120" Height="40"
                    Background="#4C9AFF" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>