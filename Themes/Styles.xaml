<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundColor" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="UserMessageColor" Color="#4C9AFF"/>
    <SolidColorBrush x:Key="BotMessageColor" Color="#34D399"/>
    <Style x:Key="PromptButton" TargetType="Button">
        <Setter Property="Background" Value="#3D3D4D"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#4C9AFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,5,0,5"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#4C9AFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
